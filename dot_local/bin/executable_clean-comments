#!/bin/bash
# Strip full-line comments (# or ;) and blank lines from config files.
# Only removes lines where the FIRST non-whitespace char is # or ;
# Usage: clean-comments <file>

FILE=$1

if [ -z "$FILE" ]; then
  echo "Usage: clean-comments <file>" >&2
  exit 1
fi

if command -v sed >/dev/null 2>&1; then
  SED=sed
elif command -v gsed >/dev/null 2>&1; then
  SED=gsed
else
  echo "clean-comments: neither sed nor gsed found" >&2
  exit 1
fi

# -i.bak form works on both BSD and GNU sed
"$SED" -i.bak -e '/^[[:space:]]*[#;]/d' -e '/^[[:space:]]*$/d' "$FILE" && rm -f "$FILE.bak"
