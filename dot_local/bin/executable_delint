#!/usr/bin/env python3
"""Strip AI-generated writing artifacts from text. Usage: pbpaste | delint | pbcopy"""
import sys
import re

text = sys.stdin.read()

# Em/en dashes to commas
text = text.replace('\u2014', ',')
text = text.replace('\u2013', ',')
text = re.sub(r'\s+,', ',', text)           # kill space before comma
text = re.sub(r',{2,}', ',', text)          # collapse double commas
text = re.sub(r',(\S)', r', \1', text)      # ensure space after comma

# Smart quotes to dumb quotes
text = text.replace('\u201c', '"').replace('\u201d', '"')
text = text.replace('\u2018', "'").replace('\u2019', "'")

# Nuke filler phrases (case insensitive, whole phrase)
filler = [
    r"I'd be happy to ",
    r"I would be happy to ",
    r"Great question! ",
    r"That's a great question! ",
    r"Absolutely! ",
    r"Certainly! ",
    r"Of course! ",
    r"Let me ",  # only at start of sentence
    r"I hope this helps!?\s*",
    r"Hope this helps!?\s*",
    r"Feel free to ",
    r"Don't hesitate to ",
    r"Please don't hesitate to ",
    r"I'm glad you asked!?\s*",
]
for f in filler:
    text = re.sub(f, '', text, flags=re.IGNORECASE)

# Kill weak sentence starters (work after . or newline or start of string)
weak_starts = [
    r'Additionally, ',
    r'Furthermore, ',
    r'Moreover, ',
    r'In conclusion, ',
    r"It's worth noting that ",
    r'It is worth noting that ',
    r"It's important to note that ",
    r'It is important to note that ',
    r'Interestingly, ',
    r'As mentioned earlier, ',
    r'That being said, ',
    r'With that being said, ',
    r'At the end of the day, ',
]
for w in weak_starts:
    text = re.sub(re.escape(w), '', text, flags=re.IGNORECASE)

# Collapse double spaces left behind
text = re.sub(r'  +', ' ', text)

# Collapse blank lines (3+ newlines to 2)
text = re.sub(r'\n{3,}', '\n\n', text)

sys.stdout.write(text)
