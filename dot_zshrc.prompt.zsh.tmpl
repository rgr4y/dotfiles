# ──────────────────────────────────────────────
# Custom Prompt
# ──────────────────────────────────────────────

# Cache hostname + user once. Embedded boxes (busybox, minimal images) may lack
# a `hostname` binary — fall back to uname -n, then $HOST, then a literal.
: ${__ZP_HOST:=$(hostname -s 2>/dev/null || hostname 2>/dev/null || uname -n 2>/dev/null || print -r -- "${HOST:-localhost}")}
: ${__ZP_USER:=${USER:-$(whoami 2>/dev/null || print -r -- "${LOGNAME:-user}")}}

# Colors
local _n='%f' _dim='%F{245}'
local _c_host='%F{cyan}' _c_cwd='%F{33}'
local _c_cwd_root='%F{red}' _c_git='%F{203}' _c_err='%F{196}' _c_tag='%F{141}'

setopt prompt_subst
autoload -U add-zsh-hook
zmodload zsh/datetime
zmodload -F zsh/stat b:zstat

{{- if ne .profile "bare" }}
# Git (fast, cached) — omitted on bare/embedded (git often absent, saves a fork
# per prompt on slow SoCs).
typeset -gA __ZP_GIT_CACHE_MTIME __ZP_GIT_CACHE_STR

__zp_find_git_dir() {
  local dir=$PWD
  while [[ $dir != / ]]; do
    if [[ -d $dir/.git ]]; then
      print -r -- "$dir/.git $dir"; return 0
    elif [[ -f $dir/.git ]]; then
      local gd; gd=$(<"$dir/.git"); gd=${gd#gitdir: }; gd=${gd## }; gd=${gd%% }
      [[ -z $gd ]] && return 1
      [[ $gd = /* ]] || gd="$dir/$gd"
      print -r -- "$gd $dir"; return 0
    fi
    dir=${dir:h}
  done
  return 1
}

git_segment() {
  local __out; __out=$(__zp_find_git_dir) || return
  local gdir=${__out%% *}
  local repo_root=${__out#* }
  local index="$gdir/index"

  local -a st; zstat -A st +mtime -- "$index" 2>/dev/null || st=(0)
  local mtime=${st[1]:-0}
  local key="${repo_root:A}"

  if [[ ${__ZP_GIT_CACHE_MTIME[$key]} == "$mtime" && -n ${__ZP_GIT_CACHE_STR[$key]} ]]; then
    print -r -- "${__ZP_GIT_CACHE_STR[$key]}"; return
  fi

  local br
  br=$(command git -C "$repo_root" symbolic-ref --short -q HEAD 2>/dev/null || \
      command git -C "$repo_root" rev-parse --short HEAD 2>/dev/null) || return

  local seg="${_c_git}[${br}]${_n}"
  __ZP_GIT_CACHE_MTIME[$key]="$mtime"
  __ZP_GIT_CACHE_STR[$key]="$seg"
  print -r -- "$seg"
}
{{- end }}

# Tags
venv_tag() { [[ -n $VIRTUAL_ENV ]] && print -r -- "${_c_tag}(${${VIRTUAL_ENV:t}})${_n}"; }
jobs_tag() { (( ${#jobstates} )) && print -r -- "${_c_tag}⚙︎${#jobstates}${_n}"; }
exit_tag() { (( $1 == 0 )) || print -r -- "${_c_err}[${1}]${_n}"; }
mode_tag() {
  case $KEYMAP in
    vicmd)  print -r -- "%F{red}[N]%f" ;;
    visual) print -r -- "%F{magenta}[V]%f" ;;
    *)      print -r -- "%F{green}[I]%f" ;;
  esac
}

{{- if and (ne .chezmoi.os "darwin") (not .is_vm) }}
# ──────────────────────────────────────────────
# CPU temperature tag (SoC thermal zones)
# ──────────────────────────────────────────────
# Hard-gated at chezmoi apply: omitted on VMs (no real thermal) and macOS.
# Resolve zone paths ONCE by type — thermal_zone numbering can shuffle across
# boots, so match cpub (big) + cpul (little) + generic cpu-thermal by name, not
# index. Shows the hotter cluster. Pure-zsh $(<file) reads = no fork per prompt.
# Returns nothing on hosts without these zones (graceful elsewhere).
typeset -ga __ZP_CPU_TZ
__zp_cpu_tz_init() {
  local z t
  for z in /sys/class/thermal/thermal_zone*/; do
    [[ -r ${z}type && -r ${z}temp ]] || continue
    t=$(<"${z}type")
    [[ $t == cpub_thermal_zone || $t == cpu-thermal || $t == cpul_thermal_zone ]] && __ZP_CPU_TZ+=("${z}temp")
  done
}
__zp_cpu_tz_init

cpu_temp_tag() {
  (( ${#__ZP_CPU_TZ} )) || return
  local f v max=0
  for f in $__ZP_CPU_TZ; do
    v=$(<"$f") 2>/dev/null || continue
    (( v > max )) && max=$v
  done
  (( max > 0 )) || return
  local c=$(( max / 1000 )) col
  if   (( c >= 75 )); then col='%F{196}'   # red   — near throttle
  elif (( c >= 60 )); then col='%F{214}'   # amber — warm
  else                     col='%F{114}'   # green — cool
  fi
  print -r -- "${col}${c}°C${_n}"
}
{{- end }}

# Keymap refresh
zle-keymap-select() { zle reset-prompt }
zle -N zle-keymap-select

# Gradient hostname (245→250→245 bounce) — computed once
__zp_gradient_host() {
  local -a ramp=(245 246 247 248 249 250 249 248 247 246)
  local len=${#ramp[@]}
  local host="$__ZP_HOST"
  local out="" i
  for (( i=0; i < ${#host}; i++ )); do
    out+="%F{${ramp[$(( i % len + 1 ))]}}"
    out+="${host:$i:1}"
  done
  out+="%f"
  print -n -- "$out"
}
typeset -g __ZP_GRAD_HOST="$(__zp_gradient_host)"

# Short pwd
short_pwd() { print -P "%~"; }

# Main prompt
build_prompt() {
  local st=$?
  local smiley suffix cwd_color
  if [[ $EUID -eq 0 ]]; then
    smiley='😈'; suffix='#'; cwd_color=$_c_cwd_root
  elif [[ $st -ne 0 ]]; then
    smiley='😡'; suffix='>'; cwd_color=$_c_cwd
  else
    smiley='😀'; suffix='>'; cwd_color=$_c_cwd
  fi

  local host_part="$__ZP_GRAD_HOST"
  [[ $__ZP_USER != "rob" ]] && host_part="%F{cyan}${__ZP_USER}@%f${host_part}"

  local left="${host_part} ${cwd_color}$(short_pwd)${_n}"
{{- if ne .profile "bare" }}
  local git="$(git_segment)"
  [[ -n $git ]] && left+=" ${git}"
{{- end }}

  local -a parts
  local p
  for p in "$(mode_tag)"{{ if and (ne .chezmoi.os "darwin") (not .is_vm) }} "$(cpu_temp_tag)"{{ end }} "$(venv_tag)" "$(jobs_tag)" "$(exit_tag $st)"; do
    [[ -n $p ]] && parts+=("$p")
  done
  local right="${(j: • :)parts}"

  PS1="${left} ${right}
${smiley} ${suffix} "
  RPROMPT=""
}

# Register via add-zsh-hook (declares precmd_functions as an array). A raw
# `precmd_functions+=build_prompt` creates a SCALAR when nothing has declared
# the array yet (e.g. no plugin manager loaded first) — zsh's precmd machinery
# only iterates the array form, so the hook silently never fires and you get
# the default %m%# prompt. add-zsh-hook is bulletproof regardless of load order.
typeset -ga precmd_functions
add-zsh-hook precmd build_prompt
