# ask ZSH integration — Ctrl+O: type description, hit Ctrl+O, get command
_ask_zsh() {
if [[ -n "$BUFFER" ]]; then
    _ask_prev_cmd=$BUFFER
    BUFFER+=" ⌛"
    zle -I && zle redisplay
    BUFFER=$(ask --shell --no-stream <<< "$_ask_prev_cmd")
    zle end-of-line
fi
}
zle -N _ask_zsh
bindkey ^O _ask_zsh

