# ── Git ──────────────────────────────────────

# Detect default branch (main or master) for current repo
_git_default_branch() {
  if git rev-parse --verify --quiet refs/heads/main >/dev/null 2>&1; then
    echo main
  elif git rev-parse --verify --quiet refs/heads/master >/dev/null 2>&1; then
    echo master
  else
    git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|origin/||' || echo main
  fi
}

alias g='git'
alias gp='git push'
alias gpo='git push origin'
gpom()  { git push origin "$(_git_default_branch)"; }
alias gs='git status'
alias gpl='git pull'
alias gplr='git pull --rebase'
gplom() { git pull origin "$(_git_default_branch)"; }
alias gcam='git commit -am'
alias gcm='git commit -m'
default() { git checkout "$(_git_default_branch)"; }
alias master='default'
alias main='default'
alias dev='git checkout dev'
alias staging='git checkout staging'
gmd() { local b=$(_git_default_branch); gpo; git checkout "$b"; git merge dev; gpo; }
gma() { local b=$(_git_default_branch); gpo; git checkout dev; git merge "$b"; gpo; git checkout "$b"; }
gmm() { local b=$(_git_default_branch); dev; git merge "$b"; gpo; }
alias gtrack='git branch --set-upstream-to=origin/$(git branch --show-current)'

