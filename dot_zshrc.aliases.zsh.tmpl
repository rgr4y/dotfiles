# List of file extensions in . that respect gitignore rules, from most to least, top 20
rag-topfiles() {
  git ls-files --cached --others --exclude-standard \
  | awk -F. 'NF>1 {ext=$NF; count[ext]++} END {for (e in count) print count[e], e}' | sort -rn | head -20
}

