{{ if eq .chezmoi.os "darwin" -}}
# ── macOS-specific ──────────────────────────
pubkey() {
  # Copy public key to clipboard and echo it back.
  local key_path="$HOME/.ssh/pubkey"
  if [ ! -r "$key_path" ]; then
    key_path="$HOME/.ssh/id_ed25519.pub"
  fi
  if [ ! -r "$key_path" ]; then
    key_path="$(ls -1 "$HOME/.ssh/"*.pub 2>/dev/null | head -n 1)"
  fi
  if [ -r "$key_path" ]; then
    pbcopy < "$key_path"
    cat "$key_path"
    return 0
  fi
  echo "pubkey: no readable public key found in $HOME/.ssh" >&2
  return 1
}
alias wireshark='/Applications/Wireshark.app/Contents/MacOS/Wireshark'
