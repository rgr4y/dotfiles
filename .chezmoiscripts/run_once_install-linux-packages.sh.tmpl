{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -euo pipefail

# Sudo guard — root needs no sudo, non-root must have passwordless sudo
# (chezmoi runs non-interactive, can't prompt)
if [[ "$(id -u)" -eq 0 ]]; then
  export SUDO=""
elif command -v sudo &>/dev/null && sudo -n true 2>/dev/null; then
  export SUDO="sudo"
else
  echo "⚠ Not root and no passwordless sudo — skipping Linux package install"
  exit 0
fi

PROFILE="{{ .profile }}"
exec "{{ .chezmoi.sourceDir }}/install.linux.sh" "$PROFILE"
{{ end -}}
