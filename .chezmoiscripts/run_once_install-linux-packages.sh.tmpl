{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
set -euo pipefail

# Skip gracefully if no sudo access (non-interactive chezmoi context)
if [[ "$(id -u)" -ne 0 ]]; then
  if ! command -v sudo &>/dev/null || ! sudo -n true 2>/dev/null; then
    echo "⚠ No root/sudo access — skipping Linux package install"
    exit 0
  fi
fi

PROFILE={{ if eq .profile "full" }}"full"{{ else }}"bare"{{ end }}
exec "{{ .chezmoi.sourceDir }}/install.linux.sh" "$PROFILE"
{{ end -}}
