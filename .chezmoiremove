# Files chezmoi should delete from the target on apply (templated).
#
# auto-sudo: remove the alias list and its loader from disk for hosts that can't
# or needn't sudo — root (already privileged), Android (no sudo), and any host
# without a sudo binary. .chezmoiignore stops them being re-created; this removes
# copies left over from a previous apply.
{{ if or (eq .chezmoi.username "root") (eq .chezmoi.os "android") (not (lookPath "sudo")) }}
.auto_sudo
.auto_sudo.zsh
{{ end }}

# clipboard shims: macOS has native pbpaste/pbcopy and ~/.local/bin is ahead of
# /usr/bin in PATH, so these shadow the real binaries. .chezmoiignore stops them
# being re-created; this deletes copies left by a previous apply.
{{ if eq .chezmoi.os "darwin" }}
.local/bin/pbpaste
.local/bin/pbcopy
.local/bin/pbcat
{{ end }}
