{{ if eq .profile "bare" -}}
# Bare profile — NO zi manager (too heavy for embedded). Just clone the two
# plugins we actually want directly with git and source their files by hand:
#   zsh-autosuggestions      (history autocomplete)
#   zsh-syntax-highlighting  (command coloring) — MUST be sourced last
# A per-dir lock lets concurrent shells cooperate on first-run clone.
_zp_clone_source() {
  # $1 = install dir, $2 = repo url, $3 = file to source once present
  local dir="$1" url="$2" file="$3" lock="$1.lock" i
  if [[ ! -f "$dir/$file" ]]; then
    if command -v git &>/dev/null; then
      mkdir -p "${dir:h}"
      if mkdir "$lock" 2>/dev/null; then
        GIT_TERMINAL_PROMPT=0 git clone --depth 1 "$url" "$dir" 2>/dev/null
        rmdir "$lock" 2>/dev/null
      else
        for i in {1..30}; do [[ -f "$dir/$file" ]] && break; sleep 1; done
      fi
    fi
  fi
  [[ -f "$dir/$file" ]] && source "$dir/$file"
}
_zp_clone_source "$HOME/.zsh/zsh-autosuggestions" \
  https://github.com/zsh-users/zsh-autosuggestions zsh-autosuggestions.zsh
_zp_clone_source "$HOME/.zsh/zsh-syntax-highlighting" \
  https://github.com/zsh-users/zsh-syntax-highlighting zsh-syntax-highlighting.zsh
unset -f _zp_clone_source
{{ else -}}
# Zi plugin manager — auto-installs if git available
if [[ ! -f "$HOME/.zi/bin/zi.zsh" ]]; then
  if command -v git &>/dev/null; then
    zi_install_lock="$HOME/.zi/install.lock"
    mkdir -p "$HOME/.zi"

    if mkdir "$zi_install_lock" 2>/dev/null; then
      mkdir -p "$HOME/.zi/bin"
      GIT_TERMINAL_PROMPT=0 git clone --depth 1 https://github.com/z-shell/zi.git "$HOME/.zi/bin" 2>/dev/null
      rmdir "$zi_install_lock" 2>/dev/null
    else
      for _zi_wait in {1..30}; do
        [[ -f "$HOME/.zi/bin/zi.zsh" ]] && break
        sleep 1
      done
    fi
    unset zi_install_lock _zi_wait
  fi
fi

[[ -f "$HOME/.zi/bin/zi.zsh" ]] || return 0 2>/dev/null || exit 0
source "$HOME/.zi/bin/zi.zsh"

# Core plugins (all profiles). `zi ice depth=1` = shallow clone (saves space +
# time); the ice modifier applies to the next zi command only.
zi ice depth=1; zi light zsh-users/zsh-autosuggestions
zi ice depth=1; zi light zsh-users/zsh-syntax-highlighting
zi ice depth=1; zi light agkozak/zsh-z
command -v sudo &>/dev/null && zi snippet OMZP::sudo

{{ if eq .profile "full" -}}
# Extra plugins (full profile)
zi ice depth=1; zi light alexrochas/zsh-extract
zi ice depth=1; zi light alexrochas/zsh-vim-crtl-z
zi ice depth=1; zi light alexrochas/zsh-git-semantic-commits
zi ice depth=1; zi light alexrochas/zsh-path-environment-explorer
{{ end -}}
{{ end -}}
