{{ if eq .profile "tiny" -}}
# Tiny profile — no zi manager. Only zsh-autosuggestions (history autocomplete).
_asug_dir="$HOME/.zsh/zsh-autosuggestions"
if [[ ! -f "$_asug_dir/zsh-autosuggestions.zsh" ]]; then
  if command -v git &>/dev/null; then
    _asug_lock="$HOME/.zsh/asug.install.lock"
    mkdir -p "$HOME/.zsh"
    if mkdir "$_asug_lock" 2>/dev/null; then
      GIT_TERMINAL_PROMPT=0 git clone --depth 1 https://github.com/zsh-users/zsh-autosuggestions "$_asug_dir" 2>/dev/null
      rmdir "$_asug_lock" 2>/dev/null
    else
      for _asug_wait in {1..30}; do
        [[ -f "$_asug_dir/zsh-autosuggestions.zsh" ]] && break
        sleep 1
      done
    fi
    unset _asug_lock _asug_wait
  fi
fi
[[ -f "$_asug_dir/zsh-autosuggestions.zsh" ]] && source "$_asug_dir/zsh-autosuggestions.zsh"
unset _asug_dir
{{ else -}}
# Zi plugin manager — auto-installs if git available
if [[ ! -f "$HOME/.zi/bin/zi.zsh" ]]; then
  if command -v git &>/dev/null; then
    zi_install_lock="$HOME/.zi/install.lock"
    mkdir -p "$HOME/.zi"

    if mkdir "$zi_install_lock" 2>/dev/null; then
      mkdir -p "$HOME/.zi/bin"
      GIT_TERMINAL_PROMPT=0 git clone --depth 1 https://github.com/z-shell/zi.git "$HOME/.zi/bin" 2>/dev/null
      rmdir "$zi_install_lock" 2>/dev/null
    else
      for _zi_wait in {1..30}; do
        [[ -f "$HOME/.zi/bin/zi.zsh" ]] && break
        sleep 1
      done
    fi
    unset zi_install_lock _zi_wait
  fi
fi

[[ -f "$HOME/.zi/bin/zi.zsh" ]] || return 0 2>/dev/null || exit 0
source "$HOME/.zi/bin/zi.zsh"

# Core plugins (all profiles)
zi light zsh-users/zsh-autosuggestions
zi light zsh-users/zsh-syntax-highlighting
zi light agkozak/zsh-z
command -v sudo &>/dev/null && zi snippet OMZP::sudo

{{ if eq .profile "full" -}}
# Extra plugins (full profile)
zi light alexrochas/zsh-extract
zi light alexrochas/zsh-vim-crtl-z
zi light alexrochas/zsh-git-semantic-commits
zi light alexrochas/zsh-path-environment-explorer
{{ end -}}
{{ end -}}
