# Always ignore
.DS_Store
**/.netrwhist
**/undodir/**
**/*.swp
**/*.swo
**/*.swn
.zsh_history
.bash_history
install.sh
install.linux.sh
docs/**
README.md
.gitignore

# CoC settings only on full profile (needs node)
{{ if ne .profile "full" }}
.vim/coc-settings.json
{{ end }}

# tmux only on full profile
{{ if ne .profile "full" }}
.tmux.conf
.tmux/**
{{ end }}

{{ if eq .chezmoi.os "darwin" }}
.local/bin/dysk-linux
.local/bin/dysk-linux.aarch64
{{ else if eq .chezmoi.arch "arm64" }}
.local/bin/dysk-darwin
.local/bin/dysk-linux
{{ else }}
.local/bin/dysk-darwin
.local/bin/dysk-linux.aarch64
{{ end }}

# Tiny embedded (armv6/armv7) — strip eyecandy/node files
# NOTE: .zshrc.zi.zsh is NOT stripped here — the tiny profile already
# reduces it to a direct zsh-autosuggestions source (no zi manager).
{{ if eq .chezmoi.arch "arm" }}
.zshrc.nvm.zsh
.neofetch
.vim/coc-settings.json
{{ end }}
