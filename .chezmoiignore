# Always ignore
.DS_Store
**/.netrwhist
**/undodir/**
**/*.swp
**/*.swo
**/*.swn
.zsh_history
.bash_history
install.sh
install.linux.sh
docs/**
README.md
.gitignore

# Ignore vim CoC settings on bare profile
{{ if eq .profile "bare" }}
.vim/coc-settings.json
{{ end }}

# Ignore tmux config if tmux module not selected
{{ if not .modules.tmux }}
.tmux.conf
.tmux/**
{{ end }}

{{ if eq .chezmoi.os "darwin" }}
.local/bin/dysk-linux
.local/bin/dysk-linux.aarch64
{{ else if eq .chezmoi.arch "arm64" }}
.local/bin/dysk-darwin
.local/bin/dysk-linux
{{ else }}
.local/bin/dysk-darwin
.local/bin/dysk-linux.aarch64
{{ end }}

# Tiny embedded (armv6/armv7) — strip plugin/eyecandy files
{{ if eq .chezmoi.arch "arm" }}
.zshrc.zi.zsh
.zshrc.nvm.zsh
.neofetch
.vim/coc-settings.json
{{ end }}
