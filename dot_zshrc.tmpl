# ──────────────────────────────────────────────
# 1. PATH
# ──────────────────────────────────────────────
export PATH="$HOME/bin:$HOME/.local/bin:/usr/local/bin:/usr/local/sbin:$PATH"

# ──────────────────────────────────────────────
# 2. History
# ──────────────────────────────────────────────
HISTFILE="$HOME/.zsh_history"
HISTSIZE=1000000000
SAVEHIST=1000000000
setopt INC_APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_REDUCE_BLANKS
setopt EXTENDED_HISTORY
setopt HIST_VERIFY

# ──────────────────────────────────────────────
# 3. OS Detection
# ──────────────────────────────────────────────
{{- if eq .chezmoi.os "darwin" }}
export DOTFILES_OS="darwin"
{{- else }}
export DOTFILES_OS="linux"
{{- end }}

is_macos() { [[ "$DOTFILES_OS" == "darwin" ]]; }
is_linux() { [[ "$DOTFILES_OS" == "linux" ]]; }
is_wsl()   { [[ "$(uname -r)" == *microsoft* ]]; }

if [[ "$GOOGLE_CLOUD_SHELL" == "true" && "$(hostname)" != "cloud-shell" ]]; then
  echo " " >> /etc/hosts
  echo "127.0.0.1 cloud-shell" >> /etc/hosts
  sudo hostname cloud-shell 2>/dev/null
fi

# ──────────────────────────────────────────────
# 4. Core Settings
# ──────────────────────────────────────────────
export ZDOTDIR=$HOME
export ZSH_COMPDUMP=$HOME/.zcompdump
export ZSH_DISABLE_COMPFIX=true
export FUNCNEST=256
export LESS='-R -M -i'
export EDITOR=vim
export RCLONE_PROGRESS=true
export LC_ALL=en_US.UTF-8

# Key bindings (vi mode)
bindkey -v
bindkey "^A" vi-beginning-of-line
bindkey "^E" vi-end-of-line
bindkey -M viins '^A' vi-beginning-of-line
bindkey -M viins '^E' vi-end-of-line

# ──────────────────────────────────────────────
# 5. Zi Plugin Manager
# ──────────────────────────────────────────────
[[ -f "$HOME/.zshrc.zi.zsh" ]] && source "$HOME/.zshrc.zi.zsh"

{{ if .modules.vscode -}}
# ──────────────────────────────────────────────
# VSCode Terminal Detection
# ──────────────────────────────────────────────
if [[ "$TERM_PROGRAM" == "vscode" || "$TERMINAL_EMULATOR" == "JetBrains-JediTerm" ]]; then
  {{ if .modules.nvm -}}
  # Lazy-load nvm for vscode
  [[ -f "$HOME/.zshrc.nvm.zsh" ]] && source "$HOME/.zshrc.nvm.zsh"
  {{ end -}}
  {{ if .modules.bun -}}
  export BUN_INSTALL="$HOME/.bun"
  export PATH="$BUN_INSTALL/bin:$PATH"
  {{ end -}}
  [[ -d "$PYENV_ROOT/bin" ]] && export PATH="$PYENV_ROOT/bin:$PATH" && eval "$(pyenv init - zsh)"
  return 0 2>/dev/null || exit 0
fi
{{ end -}}

{{ if .modules.nvm -}}
# ──────────────────────────────────────────────
# NVM (lazy-loaded)
# ──────────────────────────────────────────────
[[ -f "$HOME/.zshrc.nvm.zsh" ]] && source "$HOME/.zshrc.nvm.zsh"
{{ end -}}

{{ if .modules.pyenv -}}
# ──────────────────────────────────────────────
# Pyenv
# ──────────────────────────────────────────────
export PYENV_ROOT="$HOME/.pyenv"
[[ -d "$PYENV_ROOT/bin" ]] && export PATH="$PYENV_ROOT/bin:$PATH"
command -v pyenv &>/dev/null && eval "$(pyenv init - zsh)"
{{ end -}}

{{ if .modules.bun -}}
# ──────────────────────────────────────────────
# Bun
# ──────────────────────────────────────────────
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
[[ -s "$HOME/.bun/_bun" ]] && source "$HOME/.bun/_bun"
{{ end -}}

{{ if .modules.copilot -}}
# ──────────────────────────────────────────────
# GitHub Copilot CLI
# ──────────────────────────────────────────────
if command -v gh &>/dev/null; then
  ghcs() {
    FUNCNAME="$funcstack[1]"
    TARGET="shell"
    local GH_DEBUG="$GH_DEBUG"
    local GH_HOST="$GH_HOST"

    local OPT OPTARG OPTIND
    while getopts "dht:-:" OPT; do
      if [ "$OPT" = "-" ]; then
        OPT="${OPTARG%%=*}"
        OPTARG="${OPTARG#"$OPT"}"
        OPTARG="${OPTARG#=}"
      fi
      case "$OPT" in
        debug|d) GH_DEBUG=api ;;
        help|h)  echo "Usage: $FUNCNAME [-t shell|gh|git] <prompt>"; return 0 ;;
        hostname) GH_HOST="$OPTARG" ;;
        target|t) TARGET="$OPTARG" ;;
      esac
    done
    shift "$((OPTIND-1))"

    TMPFILE="$(mktemp -t gh-copilotXXXXXX)"
    trap 'rm -f "$TMPFILE"' EXIT
    if GH_DEBUG="$GH_DEBUG" GH_HOST="$GH_HOST" gh copilot suggest -t "$TARGET" "$@" --shell-out "$TMPFILE"; then
      if [ -s "$TMPFILE" ]; then
        FIXED_CMD="$(cat "$TMPFILE")"
        print -s -- "$FIXED_CMD"
        echo
        eval -- "$FIXED_CMD"
      fi
    else
      return 1
    fi
  }

  ghce() {
    FUNCNAME="$funcstack[1]"
    local GH_DEBUG="$GH_DEBUG"
    local GH_HOST="$GH_HOST"

    local OPT OPTARG OPTIND
    while getopts "dh-:" OPT; do
      if [ "$OPT" = "-" ]; then
        OPT="${OPTARG%%=*}"
        OPTARG="${OPTARG#"$OPT"}"
        OPTARG="${OPTARG#=}"
      fi
      case "$OPT" in
        debug|d) GH_DEBUG=api ;;
        help|h)  echo "Usage: $FUNCNAME <command>"; return 0 ;;
        hostname) GH_HOST="$OPTARG" ;;
      esac
    done
    shift "$((OPTIND-1))"

    GH_DEBUG="$GH_DEBUG" GH_HOST="$GH_HOST" gh copilot explain "$@"
  }
fi
{{ end -}}

{{ if .modules.fzf -}}
# ──────────────────────────────────────────────
# FZF
# ──────────────────────────────────────────────
if command -v fzf &>/dev/null; then
  eval "$(fzf --zsh)"
fi
{{ end -}}

[[ -f "$HOME/.zshrc.prompt.zsh" ]] && source "$HOME/.zshrc.prompt.zsh"
[[ -f "$HOME/.neofetch" ]] && cat "$HOME/.neofetch"
[[ -f "$HOME/.zshrc.aliases.zsh" ]] && source "$HOME/.zshrc.aliases.zsh"
[[ -f "$HOME/.aliases.local.zsh" ]] && source "$HOME/.aliases.local.zsh"

{{ if .modules.nvm -}}
[ -n "$NVM_DIR" ] && [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
{{ end -}}

{{- if eq .chezmoi.os "darwin" }}
fpath=($HOME/.docker/completions $fpath)
{{- end }}
autoload -Uz compinit
# Strip any fpath entries that don't exist (avoids compinit errors from missing zi completions)
fpath=(${^fpath}(N))
compinit
